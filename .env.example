PORT=3000
# Trợ lý AI: khóa chỉ đặt ở backend/.env, không đưa vào frontend hoặc Git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
NODE_ENV=development
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/YOUR_DB_NAME
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
GOOGLE_MAPS_API_KEY=
PAYMENT_PROVIDER=VNPAY
# Khóa mã hóa hồ sơ đối tác: 64 ký tự hex; dùng secret manager khi triển khai.
# Khi chạy local có thể dùng file riêng backend/.merchant-documents.key (đã gitignore).
MERCHANT_DOCUMENT_ENCRYPTION_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:3000/api/payments/vnpay-return
