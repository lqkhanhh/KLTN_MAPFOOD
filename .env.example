PORT=3000
# Trợ lý AI: khóa chỉ đặt ở backend/.env, không đưa vào frontend hoặc Git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
NODE_ENV=development
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/YOUR_DB_NAME
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
GOOGLE_MAPS_API_KEY=
# Backend: server-restricted key with Routes API enabled (preferred over legacy key).
GOOGLE_ROUTES_API_KEY=
# Web server process: public browser key, HTTP-referrer restricted; Maps JavaScript + Geocoding.
GOOGLE_MAPS_BROWSER_KEY=
PAYMENT_PROVIDER=VNPAY
# Khóa mã hóa hồ sơ đối tác: 64 ký tự hex; dùng secret manager khi triển khai.
# Khi chạy local có thể dùng file riêng backend/.merchant-documents.key (đã gitignore).
MERCHANT_DOCUMENT_ENCRYPTION_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:3000/api/payments/vnpay-return
# Firebase Authentication: public web config, all from the SAME Firebase project.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Backend only. Store outside web/ and never commit this JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
AUTH_PHONE_ENABLED=false
# Brevo email OTP (backend only). API key, not an SMTP key.
AUTH_EMAIL_OTP_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RouteBite
# Random secret at least 32 characters. Do not reuse a password.
EMAIL_OTP_SECRET=
EMAIL_OTP_DAILY_LIMIT=250
